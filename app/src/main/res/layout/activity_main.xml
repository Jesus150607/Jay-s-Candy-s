<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blanco"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/fondo_claro"
        android:clipChildren="false"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="vertical">

            <!-- Encabezado -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="210dp"
                android:background="@drawable/bg_encabezado_curvo">

                <!-- Botón menú -->
                <ImageView
                    android:id="@+id/btnMenu"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="44dp"
                    android:background="@drawable/bg_boton_atras"
                    android:contentDescription="Menú"
                    android:padding="10dp"
                    android:src="@drawable/ic_menu" />

                <!-- Título -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="54dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Texto.Encabezado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jay's "
                        android:textColor="@color/verde_lima"
                        android:textSize="18sp" />

                    <TextView
                        style="@style/Texto.Encabezado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Candy's"
                        android:textSize="18sp" />
                </LinearLayout>

                <!-- Campana con badge -->
                <FrameLayout
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="40dp"
                    android:layout_marginEnd="16dp">

                    <ImageView
                        android:id="@+id/btnNotificaciones"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="bottom|start"
                        android:background="@drawable/bg_boton_atras"
                        android:contentDescription="Notificaciones"
                        android:padding="10dp"
                        android:src="@drawable/ic_campana" />

                    <TextView
                        android:id="@+id/tvBadge"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="top|end"
                        android:background="@drawable/bg_badge"
                        android:gravity="center"
                        android:text="3"
                        android:textColor="@color/blanco"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <!-- Saludo -->
                <TextView
                    android:id="@+id/tvSaludo"
                    style="@style/Texto.Subencabezado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="24dp"
                    android:layout_marginBottom="66dp"
                    android:text="Hola, Javier" />

                <TextView
                    style="@style/Texto.Encabezado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="24dp"
                    android:layout_marginBottom="36dp"
                    android:text="¿Qué se te antoja hoy?"
                    android:textSize="22sp" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="40dp"
                    android:layout_marginBottom="70dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_destello" />
            </FrameLayout>

            <!-- Buscador (se encima sobre el encabezado) -->
            <LinearLayout
                android:id="@+id/llBuscador"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginStart="24dp"
                android:layout_marginTop="-28dp"
                android:layout_marginEnd="24dp"
                android:background="@drawable/bg_buscador"
                android:elevation="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <EditText
                    android:id="@+id/etBuscar"
                    style="@style/CampoEntrada"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="Busca dulces, frituras, galletas…"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:paddingStart="12dp" />

                <ImageView
                    android:id="@+id/btnBuscar"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_circulo_flecha"
                    android:contentDescription="Buscar"
                    android:padding="9dp"
                    android:src="@drawable/ic_buscar"
                    app:tint="@color/azul_oscuro" />
            </LinearLayout>

            <!-- Banner combo -->
            <FrameLayout
                android:id="@+id/cardCombo"
                android:layout_width="match_parent"
                android:layout_height="116dp"
                android:layout_marginStart="24dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="24dp"
                android:background="@drawable/bg_banner_combo"
                android:elevation="3dp">

                <LinearLayout
                    android:layout_width="200dp"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:paddingStart="16dp">

                    <TextView
                        style="@style/Texto.Boton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Combo dulce del día"
                        android:textColor="#FFC83D"
                        android:textSize="16sp" />

                    <TextView
                        style="@style/Texto.Secundario"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Arma el pedido y ciérralo por WhatsApp con el vendedor"
                        android:textColor="@color/blanco"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/btnVerCatalogo"
                        style="@style/Texto.Boton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_boton_mini_lima"
                        android:paddingStart="12dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="5dp"
                        android:text="Ver catálogo"
                        android:textColor="@color/azul_oscuro"
                        android:textSize="11sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="80dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="@null"
                    android:rotation="12"
                    android:src="@drawable/ic_dulce_azul" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="110dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_destello" />
            </FrameLayout>

            <!-- Categorías -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="18dp"
                android:paddingEnd="18dp"
                android:paddingBottom="16dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp">

                    <TextView
                        style="@style/Texto.Titulo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Categorías"
                        android:textSize="16sp" />

                    <TextView
                        style="@style/Texto.Secundario"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end|center_vertical"
                        android:text="4 categorías" />
                </FrameLayout>

                <!-- Fila 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/cardGalletas"
                        android:layout_width="0dp"
                        android:layout_height="130dp"
                        android:layout_margin="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_cat_galletas"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|center_horizontal"
                            android:layout_marginTop="10dp"
                            android:text="🍪"
                            android:textSize="46sp" />

                        <TextView
                            style="@style/Texto.Boton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|start"
                            android:layout_marginStart="12dp"
                            android:layout_marginBottom="26dp"
                            android:text="Galletas"
                            android:textColor="@color/blanco"
                            android:textSize="14sp" />

                        <TextView
                            style="@style/Texto.Secundario"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|start"
                            android:layout_marginStart="12dp"
                            android:layout_marginBottom="10dp"
                            android:text="20 productos"
                            android:textColor="#CCFFFFFF"
                            android:textSize="10sp" />

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="bottom|end"
                            android:layout_margin="10dp"
                            android:background="@drawable/bg_circulo_flecha"
                            android:contentDescription="@null"
                            android:padding="5dp"
                            android:src="@drawable/ic_chevron_derecha"
                            app:tint="@color/azul_oscuro" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/cardGolosinas"
                        android:layout_width="0dp"
                        android:layout_height="130dp"
                        android:layout_margin="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_cat_golosinas"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|center_horizontal"
                            android:layout_marginTop="10dp"
                            android:text="🧸"
                            android:textSize="46sp" />

                        <TextView
                            style="@style/Texto.Boton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|start"
                            android:layout_marginStart="12dp"
                            android:layout_marginBottom="26dp"
                            android:text="Golosinas"
                            android:textColor="@color/blanco"
                            android:textSize="14sp" />

                        <TextView
                            style="@style/Texto.Secundario"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|start"
                            android:layout_marginStart="12dp"
                            android:layout_marginBottom="10dp"
                            android:text="20 productos"
                            android:textColor="#CCFFFFFF"
                            android:textSize="10sp" />

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="bottom|end"
                            android:layout_margin="10dp"
                            android:background="@drawable/bg_circulo_flecha"
                            android:contentDescription="@null"
                            android:padding="5dp"
                            android:src="@drawable/ic_chevron_derecha"
                            app:tint="@color/azul_oscuro" />
                    </FrameLayout>
                </LinearLayout>

                <!-- Fila 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/cardFrituras"
                        android:layout_width="0dp"
                        android:layout_height="130dp"
                        android:layout_margin="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_cat_frituras"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|center_horizontal"
                            android:layout_marginTop="10dp"
                            android:text="🍟"
                            android:textSize="46sp" />

                        <TextView
                            style="@style/Texto.Boton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|start"
                            android:layout_marginStart="12dp"
                            android:layout_marginBottom="26dp"
                            android:text="Frituras"
                            android:textColor="@color/azul_oscuro"
                            android:textSize="14sp" />

                        <TextView
                            style="@style/Texto.Secundario"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|start"
                            android:layout_marginStart="12dp"
                            android:layout_marginBottom="10dp"
                            android:text="20 productos"
                            android:textColor="#990A1A6B"
                            android:textSize="10sp" />

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="bottom|end"
                            android:layout_margin="10dp"
                            android:background="@drawable/bg_circulo_flecha"
                            android:contentDescription="@null"
                            android:padding="5dp"
                            android:src="@drawable/ic_chevron_derecha"
                            app:tint="@color/azul_oscuro" />
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/cardChocolates"
                        android:layout_width="0dp"
                        android:layout_height="130dp"
                        android:layout_margin="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_cat_chocolates"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="top|center_horizontal"
                            android:layout_marginTop="10dp"
                            android:text="🍫"
                            android:textSize="46sp" />

                        <TextView
                            style="@style/Texto.Boton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|start"
                            android:layout_marginStart="12dp"
                            android:layout_marginBottom="26dp"
                            android:text="Chocolates"
                            android:textColor="@color/blanco"
                            android:textSize="14sp" />

                        <TextView
                            style="@style/Texto.Secundario"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|start"
                            android:layout_marginStart="12dp"
                            android:layout_marginBottom="10dp"
                            android:text="20 productos"
                            android:textColor="#CCFFFFFF"
                            android:textSize="10sp" />

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="bottom|end"
                            android:layout_margin="10dp"
                            android:background="@drawable/bg_circulo_flecha"
                            android:contentDescription="@null"
                            android:padding="5dp"
                            android:src="@drawable/ic_chevron_derecha"
                            app:tint="@color/azul_oscuro" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/include_barra_inferior" />

</LinearLayout>