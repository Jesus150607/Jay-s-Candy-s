<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_tarjeta"
    android:elevation="2dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="10dp">

    <FrameLayout
        android:id="@+id/flMiniatura"
        android:layout_width="64dp"
        android:layout_height="64dp">

        <TextView
            android:id="@+id/tvEmoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textSize="30sp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNombre"
            style="@style/Texto.Cuerpo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPresentacion"
            style="@style/Texto.Secundario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvPrecio"
            style="@style/Texto.Precio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivBasura"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="end"
            android:contentDescription="Quitar"
            android:padding="3dp"
            android:src="@drawable/ic_basura"
            app:tint="@color/texto_hint" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnMenos"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/bg_circulo_icono"
                android:contentDescription="Menos"
                android:padding="6dp"
                android:src="@drawable/ic_menos"
                app:tint="@color/azul_principal" />

            <TextView
                android:id="@+id/tvCantidad"
                style="@style/Texto.Cuerpo"
                android:layout_width="28dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnMasCant"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:background="@drawable/bg_circulo_flecha"
                android:contentDescription="Más"
                android:padding="6dp"
                android:src="@drawable/ic_mas"
                app:tint="@color/azul_oscuro" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>