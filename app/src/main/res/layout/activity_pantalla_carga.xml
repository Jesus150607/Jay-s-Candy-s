<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_carga"
    tools:context=".PantallaCarga">


    <ImageView
        android:id="@+id/ivBrillo"
        android:layout_width="380dp"
        android:layout_height="380dp"
        android:contentDescription="@null"
        android:src="@drawable/bg_brillo"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.36" />


    <ImageView
        android:layout_width="100dp"
        android:layout_height="67dp"
        android:layout_marginStart="2dp"
        android:layout_marginTop="70dp"
        android:contentDescription="@null"
        android:rotation="-12"
        android:src="@drawable/ic_dulce_azul"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:layout_width="84dp"
        android:layout_height="56dp"
        android:layout_marginTop="56dp"
        android:layout_marginEnd="10dp"
        android:contentDescription="@null"
        android:rotation="14"
        android:src="@drawable/ic_dulce_rojo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:layout_width="66dp"
        android:layout_height="44dp"
        android:layout_marginStart="44dp"
        android:layout_marginTop="40dp"
        android:contentDescription="@null"
        android:rotation="8"
        android:src="@drawable/ic_dulce_azul"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivLogo" />

    <ImageView
        android:layout_width="90dp"
        android:layout_height="60dp"
        android:layout_marginTop="58dp"
        android:layout_marginEnd="8dp"
        android:contentDescription="@null"
        android:rotation="-8"
        android:src="@drawable/ic_dulce_amarillo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivLogo" />

    <!-- Destellos -->
    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="150dp"
        android:layout_marginTop="90dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_destello"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="150dp"
        android:layout_marginEnd="110dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_destello"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/blanco" />

    <ImageView
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginStart="120dp"
        android:layout_marginBottom="170dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_destello"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:tint="@color/blanco" />

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="60dp"
        android:layout_marginBottom="120dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_destello"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Puntos -->
    <View
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_marginTop="84dp"
        android:layout_marginEnd="110dp"
        android:background="@drawable/bg_punto"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="5dp"
        android:layout_height="5dp"
        android:layout_marginStart="40dp"
        android:layout_marginBottom="260dp"
        android:alpha="0.7"
        android:background="@drawable/bg_punto"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Logo -->
    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:contentDescription="Logo Jay's Candy's"
        android:src="@drawable/logo"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.36" />

    <!-- Eslogan -->
    <TextView
        android:id="@+id/tvEslogan"
        style="@style/Texto.Cuerpo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:text="El catálogo dulce de tu universidad"
        android:textColor="@color/blanco"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivLogo" />

    <!-- Porcentaje -->
    <TextView
        android:id="@+id/tvPorcentaje"
        style="@style/Texto.Cuerpo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="72dp"
        android:text="0%"
        android:textColor="@color/verde_lima"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvEslogan" />

    <!-- Barra con perilla -->
    <SeekBar
        android:id="@+id/pbCarga"
        android:layout_width="0dp"
        android:layout_height="28dp"
        android:layout_marginStart="40dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="40dp"
        android:focusable="false"
        android:max="100"
        android:padding="0dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:progress="0"
        android:progressDrawable="@drawable/progress_splash"
        android:splitTrack="false"
        android:thumb="@drawable/thumb_carga"
        android:thumbOffset="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvPorcentaje" />

    <!-- Texto de estado -->
    <TextView
        android:id="@+id/tvEstado"
        style="@style/Texto.Secundario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Preparando tus dulces…"
        android:textColor="#CCFFFFFF"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/pbCarga" />

    <!-- Versión -->
    <TextView
        style="@style/Texto.Secundario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="v1.0.0"
        android:textColor="#80FFFFFF"
        android:textSize="10sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>