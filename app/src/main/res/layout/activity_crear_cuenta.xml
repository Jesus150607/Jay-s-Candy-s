<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_claro"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:context=".crear_cuenta">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Encabezado corto -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:background="@drawable/bg_encabezado_curvo"
            android:paddingTop="24dp">

            <ImageView
                android:id="@+id/btnAtras"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center_vertical|start"
                android:layout_marginStart="16dp"
                android:background="@drawable/bg_boton_atras"
                android:contentDescription="Regresar"
                android:padding="8dp"
                android:src="@drawable/ic_flecha_atras" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="8dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    style="@style/Texto.Encabezado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Crear cuenta" />

                <TextView
                    style="@style/Texto.Subencabezado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Regístrate para hacer tus pedidos" />
            </LinearLayout>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="30dp"
                android:layout_marginBottom="30dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_destello" />
        </FrameLayout>

        <!-- Formulario -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="12dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <!-- Nombre -->
            <TextView
                style="@style/Texto.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Nombre completo" />

            <LinearLayout
                style="@style/CampoContenedor"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp">

                <ImageView
                    style="@style/CampoIcono"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_persona" />

                <EditText
                    android:id="@+id/etNombre"
                    style="@style/CampoEntrada"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="Ej. Javier Trejo Enríquez"
                    android:importantForAutofill="no"
                    android:inputType="textPersonName|textCapWords" />
            </LinearLayout>

            <!-- Teléfono -->
            <TextView
                style="@style/Texto.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Número de teléfono" />

            <LinearLayout
                style="@style/CampoContenedor"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp">

                <ImageView
                    style="@style/CampoIcono"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_telefono" />

                <EditText
                    android:id="@+id/etTelefono"
                    style="@style/CampoEntrada"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="Ej. 55 1234 5678"
                    android:importantForAutofill="no"
                    android:inputType="phone"
                    android:maxLength="10" />
            </LinearLayout>

            <!-- Carrera -->
            <TextView
                style="@style/Texto.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Carrera" />

            <LinearLayout
                android:id="@+id/llCarrera"
                style="@style/CampoContenedor"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp">

                <ImageView
                    style="@style/CampoIcono"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_birrete" />

                <Spinner
                    android:id="@+id/spCarrera"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:padding="0dp"
                    android:popupBackground="@drawable/bg_campo"
                    android:spinnerMode="dropdown" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_flecha_abajo"
                    app:tint="@color/texto_secundario" />
            </LinearLayout>

            <!-- Edificio -->
            <TextView
                style="@style/Texto.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Edificio" />

            <LinearLayout
                android:id="@+id/llEdificio"
                style="@style/CampoContenedor"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp">

                <ImageView
                    style="@style/CampoIcono"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_edificio" />

                <Spinner
                    android:id="@+id/spEdificio"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:padding="0dp"
                    android:popupBackground="@drawable/bg_campo"
                    android:spinnerMode="dropdown" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_flecha_abajo"
                    app:tint="@color/texto_secundario" />
            </LinearLayout>

            <!-- Contraseña -->
            <TextView
                style="@style/Texto.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Contraseña" />

            <LinearLayout
                style="@style/CampoContenedor"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp">

                <ImageView
                    style="@style/CampoIcono"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_candado" />

                <EditText
                    android:id="@+id/etPassword"
                    style="@style/CampoEntrada"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="Mínimo 6 caracteres"
                    android:importantForAutofill="no"
                    android:inputType="textPassword" />

                <ImageView
                    android:id="@+id/ivVerPassword"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Mostrar contraseña"
                    android:padding="6dp"
                    android:src="@drawable/ic_dulce_cerrado"
                    app:tint="@color/azul_principal" />
            </LinearLayout>

            <!-- Confirmar contraseña -->
            <TextView
                style="@style/Texto.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Confirmar contraseña" />

            <LinearLayout
                style="@style/CampoContenedor"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp">

                <ImageView
                    style="@style/CampoIcono"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_candado" />

                <EditText
                    android:id="@+id/etConfirmar"
                    style="@style/CampoEntrada"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="Repite tu contraseña"
                    android:importantForAutofill="no"
                    android:inputType="textPassword" />

                <ImageView
                    android:id="@+id/ivVerConfirmar"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Mostrar contraseña"
                    android:padding="6dp"
                    android:src="@drawable/ic_dulce_cerrado"
                    app:tint="@color/azul_principal" />
            </LinearLayout>

            <TextView
                style="@style/Texto.Secundario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Tu número se usa para enviar tu pedido por WhatsApp." />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnRegistrarme"
                style="@style/BotonLima"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="28dp"
                android:text="Registrarme ›" />

            <TextView
                style="@style/Texto.Secundario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="¿Ya tienes cuenta?"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvIniciarSesion"
                style="@style/Texto.Cuerpo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="8dp"
                android:text="Iniciar sesión"
                android:textColor="@color/azul_principal"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>