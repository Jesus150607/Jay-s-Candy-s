<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="76dp"
    android:background="@drawable/bg_barra_inferior"
    android:elevation="12dp"
    android:orientation="horizontal"
    android:paddingTop="6dp">

    <!-- Carrito -->
    <LinearLayout
        android:id="@+id/navCarrito"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivNavCarrito"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="Carrito"
            android:padding="11dp"
            android:src="@drawable/ic_carrito" />

        <TextView
            android:id="@+id/tvNavCarrito"
            style="@style/Texto.Secundario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Carrito" />
    </LinearLayout>

    <!-- Inicio -->
    <LinearLayout
        android:id="@+id/navInicio"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivNavInicio"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="Inicio"
            android:padding="11dp"
            android:src="@drawable/ic_casa" />

        <TextView
            android:id="@+id/tvNavInicio"
            style="@style/Texto.Secundario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Inicio" />
    </LinearLayout>

    <!-- Perfil -->
    <LinearLayout
        android:id="@+id/navPerfil"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/ivNavPerfil"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="Perfil"
            android:padding="11dp"
            android:src="@drawable/ic_persona" />

        <TextView
            android:id="@+id/tvNavPerfil"
            style="@style/Texto.Secundario"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Perfil" />
    </LinearLayout>

</LinearLayout>