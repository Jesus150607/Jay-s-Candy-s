<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_claro"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:context=".EditarDatosActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include layout="@layout/include_encabezado" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="12dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <!-- Foto de perfil -->
            <FrameLayout
                android:id="@+id/btnCambiarFoto"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_avatar_grande"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:id="@+id/tvAvatarLetra"
                    style="@style/Texto.Titulo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="U"
                    android:textSize="28sp" />

                <ImageView
                    android:id="@+id/ivFotoPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Foto de perfil"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_circulo_flecha"
                    android:contentDescription="Cambiar foto"
                    android:padding="5dp"
                    android:src="@drawable/ic_lapiz"
                    app:tint="@color/azul_oscuro" />
            </FrameLayout>

            <TextView
                style="@style/Texto.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Nombre completo" />

            <LinearLayout
                style="@style/CampoContenedor"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp">

                <ImageView
                    style="@style/CampoIcono"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_persona" />

                <EditText
                    android:id="@+id/etNombre"
                    style="@style/CampoEntrada"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="Nombre completo"
                    android:importantForAutofill="no"
                    android:inputType="textPersonName|textCapWords" />
            </LinearLayout>

            <!-- Teléfono -->
            <TextView
                style="@style/Texto.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Número de teléfono" />

            <LinearLayout
                style="@style/CampoContenedor"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp">

                <ImageView
                    style="@style/CampoIcono"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_telefono" />

                <EditText
                    android:id="@+id/etTelefono"
                    style="@style/CampoEntrada"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="Número de 10 dígitos"
                    android:importantForAutofill="no"
                    android:inputType="phone"
                    android:maxLength="10" />
            </LinearLayout>

            <!-- Edificio -->
            <TextView
                style="@style/Texto.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Edificio" />

            <LinearLayout
                android:id="@+id/llEdificio"
                style="@style/CampoContenedor"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp">

                <ImageView
                    style="@style/CampoIcono"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_edificio" />

                <Spinner
                    android:id="@+id/spEdificio"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:padding="0dp"
                    android:popupBackground="@drawable/bg_campo"
                    android:spinnerMode="dropdown" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_flecha_abajo"
                    app:tint="@color/texto_secundario" />
            </LinearLayout>

            <TextView
                style="@style/Texto.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Nueva contraseña" />

            <LinearLayout
                style="@style/CampoContenedor"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp">

                <ImageView
                    style="@style/CampoIcono"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_candado" />

                <EditText
                    android:id="@+id/etPassword"
                    style="@style/CampoEntrada"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:hint="••••••••"
                    android:importantForAutofill="no"
                    android:inputType="textPassword" />

                <ImageView
                    android:id="@+id/ivVerPassword"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Mostrar contraseña"
                    android:padding="6dp"
                    android:src="@drawable/ic_dulce_cerrado"
                    app:tint="@color/azul_principal" />
            </LinearLayout>

            <TextView
                style="@style/Texto.Secundario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Déjala en blanco si no quieres cambiarla." />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnGuardar"
                style="@style/BotonLima"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:text="Guardar cambios" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCancelar"
                style="@style/BotonBorde"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="Cancelar"
                android:textColor="@color/texto_secundario" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>